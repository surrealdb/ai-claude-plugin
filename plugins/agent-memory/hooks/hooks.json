{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/agent-memory.sh\" recall",
						"timeout": 12
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/agent-memory.sh\" recall",
						"timeout": 12
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/agent-memory.sh\" remember",
						"timeout": 15
					}
				]
			}
		]
	}
}
